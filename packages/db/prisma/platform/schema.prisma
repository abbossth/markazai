// Control Plane bazasi (`platform_db`): tashkilotlar, obuna, billing, platforma xodimlari.
// Bu bazada talaba/guruh/to'lov kabi tenant ma'lumoti HECH QACHON saqlanmaydi — faqat agregat sonlar (UsageMetric).
generator client {
  provider = "prisma-client"
  output   = "../../src/generated-platform"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  DELETED
}

// O'quv markaz o'z talabalaridan pulni qanday yechishi (modme "To'lov rejimi"). Hozir amalda faqat DAILY
// (dars bo'yicha) ishlaydi; qolganlari Control Plane'da belgilanadi va footer'da ko'rsatiladi.
enum ChargeMode {
  DAILY
  CALENDAR
  GROUP_START
  MODULE
  INDIVIDUAL
  FULL_COURSE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PlatformRole {
  OWNER
  BILLING
  SUPPORT
}

model Organization {
  // ID tenant bazasidagi `organization_id` bilan bir xil (provisioning shu ID bilan tenant ma'lumotini yaratadi).
  id           String    @id @db.Uuid
  name         String
  slug         String    @unique
  status       OrgStatus @default(TRIAL)
  contactName  String    @map("contact_name")
  contactPhone String    @map("contact_phone")
  contactEmail String?   @map("contact_email")
  logoUrl      String?   @map("logo_url")
  chargeMode   ChargeMode @default(DAILY) @map("charge_mode")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  subscriptions Subscription[]
  flags         FeatureFlag[]
  usage         UsageMetric[]

  @@map("organizations")
}

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  monthlyPrice Int      @map("monthly_price")
  // null — cheksiz
  maxStaff     Int?     @map("max_staff")
  maxBranches  Int?     @map("max_branches")
  maxStudents  Int?     @map("max_students")
  // Yoqilgan modullar (masalan "gamification")
  modules      String[]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  // 1 / 3 / 6 / 12 oy
  billingCycle   Int                @map("billing_cycle")
  price          Int
  status         SubscriptionStatus @default(ACTIVE)
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  createdAt      DateTime           @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan            @relation(fields: [planId], references: [id])
  payments     PaymentRecord[]

  @@index([organizationId, endDate])
  @@map("subscriptions")
}

model PaymentRecord {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  amount         Int
  paidAt         DateTime @map("paid_at") @db.Date
  method         String
  // Kim tasdiqlagan (platforma xodimi email'i)
  confirmedBy    String   @map("confirmed_by")
  receiptUrl     String?  @map("receipt_url")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("payment_records")
}

model FeatureFlag {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  module         String
  enabled        Boolean

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, module])
  @@map("feature_flags")
}

// Platforma xodimlari — tenant login tizimidan butunlay mustaqil (alohida jadval, sir, cookie).
model PlatformAdmin {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String       @map("password_hash")
  role         PlatformRole @default(SUPPORT)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  lastLoginAt  DateTime?    @map("last_login_at")

  @@map("platform_admins")
}

// Faqat agregat sonlar — tafsilot hech qachon yozilmaydi.
model UsageMetric {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  studentsCount  Int       @map("students_count")
  staffCount     Int       @map("staff_count")
  groupsCount    Int       @map("groups_count")
  lastLoginAt    DateTime? @map("last_login_at")
  recordedAt     DateTime  @default(now()) @map("recorded_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, recordedAt])
  @@map("usage_metrics")
}

// Control Plane harakatlari (tashkilot yaratish, status o'zgartirish, to'lov tasdiqlash...) — o'zgarmas audit-log.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  adminEmail String   @map("admin_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

// Video darsliklar (yordam): platforma egasi YouTube'ga yuklab, havolasini Control Plane'da kiritadi; hamma tenant ko'radi.
model HelpVideo {
  id        String   @id @default(uuid()) @db.Uuid
  category  String
  title     String
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category, sortOrder])
  @@map("help_videos")
}
