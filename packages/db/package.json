{
  "name": "@markazai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./platform": "./src/platform.ts"
  },
  "scripts": {
    "generate": "prisma generate && prisma generate --config prisma.platform.config.ts",
    "migrate:dev": "prisma migrate dev && prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "reset": "prisma migrate reset --force && npm run seed",
    "billing:rebuild": "tsx prisma/rebuild-billing.ts",
    "test": "vitest run",
    "platform:migrate": "prisma migrate deploy --config prisma.platform.config.ts && prisma generate --config prisma.platform.config.ts",
    "platform:generate": "prisma generate --config prisma.platform.config.ts",
    "platform:seed": "tsx prisma/platform/seed.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@markazai/types": "^0.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.0"
  }
}
