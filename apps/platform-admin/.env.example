# platform-admin (Control Plane) muhiti. TENANT bazasi (DATABASE_URL / APP_DATABASE_URL) bu yerda BO'LMASLIGI shart.
PLATFORM_DATABASE_URL="postgresql://USER@localhost:5432/markazai_platform"
# Sessiya sirri — tenant-app'ning AUTH_SECRET'idan FARQLI bo'lishi shart: openssl rand -base64 32
PLATFORM_AUTH_SECRET=""
# tenant-app ichki API'si (provisioning/usage) — imzo sirri ikkala ilovada bir xil
PROVISIONING_SECRET=""
TENANT_APP_URL="http://localhost:3100"
# Tashkilot manzilini ko'rsatish uchun ({slug}.ROOT_DOMAIN). Dev'da tenant'lar {slug}.localhost:3100
ROOT_DOMAIN="localhost"
