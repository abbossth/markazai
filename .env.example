# Tenant bazasi — EGASI ulanishi (migratsiya, seed, testlar). RLS'ni aylanib o'tadi: ilova sifatida ishlatilmaydi.
DATABASE_URL="postgresql://USER@localhost:5432/markazai_tenant"
# Tenant bazasi — ILOVA ulanishi: cheklangan `markazai_app` roli (RLS policy'lari shunga qo'llanadi).
# Rolni migratsiya yaratadi (NOLOGIN); parolni siz berasiz: ALTER ROLE markazai_app LOGIN PASSWORD '...';
# Production'da SHART (yo'q bo'lsa ilova ishga tushmaydi).
APP_DATABASE_URL="postgresql://markazai_app:PASSWORD@localhost:5432/markazai_tenant"
# Control Plane bazasi (faqat platform-admin app'i uchun; 9-bosqichda ishlatiladi).
PLATFORM_DATABASE_URL="postgresql://USER@localhost:5432/markazai_platform"

# Auth.js (NextAuth v5). Yaratish: npx auth secret  yoki  openssl rand -base64 32
AUTH_SECRET=""

# Bitta-tenant rejimi (1–8-bosqichlar): statik organization ID.
DEFAULT_ORGANIZATION_ID="00000000-0000-4000-8000-000000000001"

# Keyingi bosqichlar (hozircha ishlatilmaydi / mock)
UPSTASH_REDIS_URL=""
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Yuklangan fayllar (logotip, banner). Bo'sh — apps/tenant-app/.uploads
UPLOAD_DIR=""

# ── Multi-tenant (9-bosqich) ──
# Asosiy domen. Production: markazai.uz ({slug}.markazai.uz — tenant, admin.markazai.uz — Control Plane). Dev: localhost.
ROOT_DOMAIN="localhost"
# FAQAT dev: subdomensiz host (localhost, 127.0.0.1) shu tenant'ga yo'naltiriladi. Production'da e'tiborga olinmaydi.
DEFAULT_TENANT_SLUG="demo"
# tenant-app ↔ platform-admin ichki so'rovlari imzosi (HMAC). Ikkala ilovada bir xil, kamida 16 belgi: openssl rand -hex 24
PROVISIONING_SECRET=""
# platform-admin tenant-app'ning ichki API'sini shu manzil bo'yicha chaqiradi (tenant BAZASIGA ulanmaydi)
TENANT_APP_URL="http://localhost:3100"
# platform-admin sessiyasi uchun ALOHIDA sir (tenant AUTH_SECRET'dan farq qilishi shart): openssl rand -base64 32
PLATFORM_AUTH_SECRET=""
