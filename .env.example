# Tenant bazasi (barcha o'quv markazlar). 9-bosqichdan keyin RLS shu bazada yoqiladi.
DATABASE_URL="postgresql://USER@localhost:5432/markazai_tenant"
# Control Plane bazasi (faqat platform-admin app'i uchun; 9-bosqichda ishlatiladi).
PLATFORM_DATABASE_URL="postgresql://USER@localhost:5432/markazai_platform"

# Auth.js (NextAuth v5). Yaratish: npx auth secret  yoki  openssl rand -base64 32
AUTH_SECRET=""

# Bitta-tenant rejimi (1–8-bosqichlar): statik organization ID.
DEFAULT_ORGANIZATION_ID="00000000-0000-4000-8000-000000000001"

# Keyingi bosqichlar (hozircha ishlatilmaydi / mock)
UPSTASH_REDIS_URL=""
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
